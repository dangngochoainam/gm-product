# Application Environment
ENV=dev
GRPC_PORT=50050
# Probes and metrics only. Never expose this port through an ingress.
ADMIN_PORT=50051
SHUTDOWN_DRAIN_DELAY=5s
SHUTDOWN_TIMEOUT=25s

# Database Configuration
DATABASE_POSTGRES__HOST=localhost
DATABASE_POSTGRES__PORT=5434
DATABASE_POSTGRES__DATABASE=ecommerce
DATABASE_POSTGRES__SCHEMA=user
DATABASE_POSTGRES__USERNAME=root
DATABASE_POSTGRES__PASSWORD=Abc12345
DATABASE_POSTGRES__LOGGING_ENABLED=false
DATABASE_POSTGRES__AUTO_MIGRATION=false

# No CORS setting here on purpose: browsers never reach this service directly.
# Origins are configured in gm-gateway, the only public HTTP surface.
